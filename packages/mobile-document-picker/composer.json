{
    "name": "livemaas/mobile-document-picker",
    "description": "Pick PDFs, photos and videos from the iOS Files app in a NativePHP Mobile app.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Livemaas\\MobileDocumentPicker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Livemaas\\MobileDocumentPicker\\DocumentPickerServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
